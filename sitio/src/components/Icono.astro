---
// Íconos Phosphor (regular) como SVG en línea: sin fuente de íconos ni pedidos extra.
interface Props { nombre: string; class?: string }
const { nombre, class: clase = '' } = Astro.props;
const svgs = import.meta.glob('/node_modules/@phosphor-icons/core/assets/regular/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = svgs[`/node_modules/@phosphor-icons/core/assets/regular/${nombre}.svg`] as string | undefined;
if (!raw) throw new Error(`Ícono Phosphor no encontrado: ${nombre}`);
const svg = raw.replace('<svg ', `<svg class="ph ${clase}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />
